    {
      "parameters": {
        "jsCode": "// Meta присилає пачку подій: body.entry[].messaging[]\n// Залишаємо тільки вхідні повідомлення живого клієнта.\nconst out = [];\n\nfor (const item of $input.all()) {\n  const body = item.json.body ?? {};\n  if (body.object !== 'instagram') continue;\n\n  for (const entry of body.entry ?? []) {\n    for (const ev of entry.messaging ?? []) {\n      const msg = ev.message;\n\n      if (!msg) continue;         // read / reaction / postback — не повідомлення\n      if (msg.is_echo) continue;  // ехо нашої ж відповіді → інакше бот говорить сам із собою\n      if (msg.is_deleted) continue;\n\n      const attachments = msg.attachments ?? [];\n\n      out.push({\n        json: {\n          sender_id: ev.sender?.id ?? '',        // IGSID клієнта — на нього відповідаємо\n          recipient_id: ev.recipient?.id ?? '',  // наш IG business account id\n          mid: msg.mid ?? '',\n          text: msg.text ?? '',\n          is_story_reply: Boolean(msg.reply_to?.story),\n          attachment_types: attachments.map((a) => a.type),\n          received_at: new Date(ev.timestamp ?? Date.now()).toISOString(),\n        },\n      });\n    }\n  }\n}\n\nreturn out;"
      },
